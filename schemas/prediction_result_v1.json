{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/prediction_result_v1.json",
  "title": "PredictionResult",
  "type": "object",
  "required": ["CL", "CD", "Cm", "LD", "fidelity", "model_version"],
  "properties": {
    "CL": { "type": "number", "description": "Coeficiente de sustentación" },
    "CD": { "type": "number", "description": "Coeficiente de resistencia total" },
    "Cm": { "type": "number", "description": "Coeficiente de momento de cabeceo" },
    "LD": { "type": "number", "description": "Eficiencia aerodinámica L/D" },
    "S_m2": { "type": "number", "description": "Superficie alar de referencia en m²" },
    "AR": { "type": "number", "description": "Alargamiento alar Aspect Ratio" },
    "e": { "type": "number", "description": "Factor de eficiencia de Oswald" },
    "fidelity": { "type": "string", "enum": ["empirical", "neuralfoil", "custom_onnx"] },
    "model_version": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "timestamp": { "type": "string" }
  }
}
