# =============================================================================
# OptimAirWing — Environment Variables (Template)
# =============================================================================
# Copia este archivo a .env y completa los valores reales
# =============================================================================

# Entorno
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Seguridad
JWT_SECRET=dev_jwt_secret_change_in_prod
ADMIN_SECRET_KEY=dev_secret
API_KEY=optimairwing_dev_key_2026

# Frontend URL (para CORS y enlaces en emails)
VITE_APP_URL=http://localhost:3000

# CORS (separado por comas)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Base de datos (SQLite local por defecto)
# DB_PATH=data/optimairwing.db

# Gemini AI API Key — Obtén una en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Python CFD Backend (opcional)
PYTHON_PATH=python3

# Stripe (opcional - sin esto, los pagos se simulan localmente)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=

# Resend Email (opcional - sin esto, los emails se omiten)
RESEND_API_KEY=
EMAIL_FROM=noreply@optimairwing.app

# Sentry Error Tracking (opcional)
SENTRY_DSN=

# Backup automático (expresión cron, default cada 6h)
BACKUP_CRON=0 */6 * * *

# Vercel KV (opcional - para despliegue en Vercel)
# VERCEL_KV_URL=
# KV_URL=
